# Create corners : ICC2 style
# between the I/O guides LEFT and TOP
create_io_corner_cell -reference_cell PCORNER_18_18_NT_DR {LEFT TOP}
create_io_corner_cell -reference_cell PCORNER_18_18_NT_DR {TOP RIGHT}
create_io_corner_cell -reference_cell PCORNER_18_18_NT_DR {RIGHT BOTTOM}
create_io_corner_cell -reference_cell PCORNER_18_18_NT_DR {BOTTOM LEFT}


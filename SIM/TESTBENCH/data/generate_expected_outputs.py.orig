#!/usr/bin/env python3
"""Generate deterministic random stimulus and golden events for every architecture."""

import argparse
import csv
from collections import OrderedDict, deque
from pathlib import Path
import sys


DIMENSION = 8
BIT_LENGTH = 8
VALUE_WIDTH = 16
OUTPUT_BUFFER_DEPTH = 10
SAMPLE_COUNT = 2048
LFSR_SEED = 0xACE1
LFSR_TAPS = 0xD008
RANDOM_SEED = 0x51A72026
VALUE_MASK = (1 << VALUE_WIDTH) - 1

ARCHITECTURES = OrderedDict([
    ("baseline", (False, False, False, False)),
    ("group_mask", (False, False, False, True)),
    ("lfsr", (True, False, False, False)),
    ("lfsr_group_mask", (True, False, False, True)),
    ("lfsr_sort", (True, True, False, False)),
    ("lfsr_sort_group_mask", (True, True, False, True)),
    ("lfsr_sort_zero_delete", (True, True, True, False)),
    ("lfsr_sort_zero_delete_group_mask", (True, True, True, True)),
    ("lfsr_zero_delete", (True, False, True, False)),
    ("lfsr_zero_delete_group_mask", (True, False, True, True)),
    ("sort", (False, True, False, False)),
    ("sort_group_mask", (False, True, False, True)),
    ("sort_zero_delete", (False, True, True, False)),
    ("sort_zero_delete_group_mask", (False, True, True, True)),
    ("zero_delete", (False, False, True, False)),
    ("zero_delete_group_mask", (False, False, True, True)),
])


def parse_args():
    script_dir = Path(__file__).resolve().parent
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--stimulus",
        type=Path,
        default=script_dir / "x_d_training_pairs.hex",
        help="Packed normalized X/D input file.",
    )
    parser.add_argument(
        "--random-output",
        type=Path,
        default=script_dir / "random_values.hex",
        help="Packed deterministic external-random vectors.",
    )
    parser.add_argument(
        "--expected-dir",
        type=Path,
        default=script_dir / "expected",
        help="Directory receiving one expected event file per architecture.",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="Check committed files without rewriting them.",
    )
    return parser.parse_args()


def unpack_lanes(word, lane_width):
    mask = (1 << lane_width) - 1
    return tuple(
        (word >> (lane * lane_width)) & mask
        for lane in range(DIMENSION)
    )


def pack_lanes(lanes, lane_width):
    return sum(
        int(value) << (lane * lane_width)
        for lane, value in enumerate(lanes)
    )


def read_vector_pairs(path):
    lines = [
        line.strip()
        for line in path.read_text(encoding="ascii").splitlines()
        if line.strip()
    ]
    if len(lines) != SAMPLE_COUNT:
        raise ValueError(
            "{} contains {} samples, expected {}".format(
                path, len(lines), SAMPLE_COUNT
            )
        )

    vector_width = DIMENSION * VALUE_WIDTH
    vector_mask = (1 << vector_width) - 1
    pairs = []
    for line_number, line in enumerate(lines, 1):
        packed = int(line, 16)
        d_word = packed & vector_mask
        x_word = (packed >> vector_width) & vector_mask
        pairs.append((
            unpack_lanes(x_word, VALUE_WIDTH),
            unpack_lanes(d_word, VALUE_WIDTH),
        ))
    return pairs


def xorshift32(value):
    value &= 0xFFFFFFFF
    value ^= (value << 13) & 0xFFFFFFFF
    value ^= value >> 17
    value ^= (value << 5) & 0xFFFFFFFF
    return value & 0xFFFFFFFF


def generate_random_pairs():
    """Match the shared RTL LFSR sequence for fair external/LFSR comparison."""
    lfsr_value = LFSR_SEED
    d_delay_1 = LFSR_SEED
    d_delay_2 = LFSR_SEED
    pairs = []
    for _sample in range(SAMPLE_COUNT):
        pairs.append((
            (lfsr_value,) * DIMENSION,
            (d_delay_2,) * DIMENSION,
        ))
        old_lfsr = lfsr_value
        old_d_delay_1 = d_delay_1
        lfsr_value = next_lfsr(old_lfsr)
        d_delay_1 = old_lfsr
        d_delay_2 = old_d_delay_1
    return pairs


def packed_pair_lines(pairs):
    vector_width = DIMENSION * VALUE_WIDTH
    digits = (2 * vector_width) // 4
    return [
        "{:0{}x}".format(
            (pack_lanes(x_values, VALUE_WIDTH) << vector_width) |
            pack_lanes(d_values, VALUE_WIDTH),
            digits,
        )
        for x_values, d_values in pairs
    ]


def parity(value):
    result = 0
    while value:
        result ^= value & 1
        value >>= 1
    return result


def next_lfsr(value):
    feedback = parity(value & LFSR_TAPS)
    return ((value << 1) & VALUE_MASK) | feedback


def pulse_vector(input_values, random_values):
    if isinstance(random_values, int):
        return tuple(int(random_values < value) for value in input_values)
    return tuple(
        int(random_value < input_value)
        for input_value, random_value in zip(input_values, random_values)
    )


def pack_pulses(pulses):
    return sum(int(value) << lane for lane, value in enumerate(pulses))


class GoldenArchitecture(object):
    """Cycle model of ARCH_TOP and its enabled preprocessing modules."""

    def __init__(self, architecture, flags):
        self.architecture = architecture
        (
            self.use_lfsr,
            self.enable_sort,
            self.enable_zero_delete,
            self.enable_group_mask,
        ) = flags

        self.lfsr_value = LFSR_SEED
        self.d_lfsr_delay_1 = LFSR_SEED
        self.d_lfsr_delay_2 = LFSR_SEED

        self.source_index = 0
        self.source_set_captured = False
        self.preprocessing_complete = False
        self.frame_done = False

        self.sort_x_frame = [
            (0,) * DIMENSION for _index in range(BIT_LENGTH)
        ]
        self.sort_d_counts = [0] * DIMENSION
        self.sort_input_index = 0
        self.sort_output_index = 0
        self.sort_frame_captured = False

        self.group_state = "capture"
        self.groups = []
        self.group_drain_index = 0
        self.group_layer_index = 0
        self.group_frame_done = False
        self.group_pending = None
        self.group_input_closed = False

        self.fifo = deque()
        self.events = []
        self.accepted_samples = 0
        self.completed_frames = 0
        self.cycle = 0
        self.transform_input_updates = [0] * (DIMENSION * DIMENSION)
        self.transform_output_updates = [0] * (DIMENSION * DIMENSION)
        self.validated_transform_frames = 0

    def group_outputs(self):
        if self.group_state != "drain":
            return False, (0,) * DIMENSION, (0,) * DIMENSION, False

        group = self.groups[self.group_drain_index]
        x_output = tuple(
            int(count > self.group_layer_index)
            for count in group["counts"]
        )
        another_layer = any(
            count > (self.group_layer_index + 1)
            for count in group["counts"]
        )
        return True, x_output, group["d"], another_layer

    def accumulate_crossbar_update(self, counts, x_pulses, d_pulses):
        for x_lane in range(DIMENSION):
            if not x_pulses[x_lane]:
                continue
            for d_lane in range(DIMENSION):
                if d_pulses[d_lane]:
                    update_index = x_lane * DIMENSION + d_lane
                    counts[update_index] += 1

    def run(self, stimuli, random_pairs):
        driver_started = False
        driver_valid = False
        driver_waiting_for_frame = False
        driver_index = 0
        maximum_cycles = 250000

        while self.completed_frames < (SAMPLE_COUNT // BIT_LENGTH):
            if self.cycle >= maximum_cycles:
                raise RuntimeError(
                    "{} golden model timed out at cycle {}".format(
                        self.architecture, self.cycle
                    )
                )

            if driver_valid:
                x_values, d_values = stimuli[driver_index]
                x_random_values, d_random_values = random_pairs[driver_index]
            else:
                x_values = (0,) * DIMENSION
                d_values = (0,) * DIMENSION
                x_random_values = (0,) * DIMENSION
                d_random_values = (0,) * DIMENSION

            source_input_valid = (
                driver_valid and not self.source_set_captured
            )
            source_last = self.source_index == (BIT_LENGTH - 1)

            if self.use_lfsr:
                x_pulses_generated = pulse_vector(
                    x_values, self.lfsr_value
                )
                d_pulses_generated = pulse_vector(
                    d_values, self.d_lfsr_delay_2
                )
            else:
                x_pulses_generated = pulse_vector(
                    x_values, x_random_values
                )
                d_pulses_generated = pulse_vector(
                    d_values, d_random_values
                )

            fifo_valid = bool(self.fifo)
            fifo_head = self.fifo[0] if fifo_valid else None
            fifo_pop = fifo_valid
            fifo_ready = (
                len(self.fifo) < OUTPUT_BUFFER_DEPTH or fifo_pop
            )

            if self.enable_sort:
                sort_input_ready = not self.sort_frame_captured
                current_d_layer = tuple(
                    int(count > self.sort_output_index)
                    for count in self.sort_d_counts
                )
                saturated_layer_ready = all(current_d_layer)
                preprocess_valid = (
                    self.sort_frame_captured or saturated_layer_ready
                )
                preprocess_last = (
                    preprocess_valid and
                    self.sort_output_index == (BIT_LENGTH - 1)
                )
                if preprocess_valid:
                    x_preprocessed = self.sort_x_frame[
                        self.sort_output_index
                    ]
                    d_preprocessed = current_d_layer
                else:
                    x_preprocessed = (0,) * DIMENSION
                    d_preprocessed = (0,) * DIMENSION
            else:
                sort_input_ready = False
                preprocess_valid = source_input_valid
                preprocess_last = source_last
                x_preprocessed = x_pulses_generated
                d_preprocessed = d_pulses_generated

            keep_pair = (
                (any(x_preprocessed) and any(d_preprocessed))
                if self.enable_zero_delete else True
            )

            (
                group_output_valid,
                group_x_output,
                group_d_output,
                another_group_layer,
            ) = self.group_outputs()
            group_input_ready = (
                self.group_state == "capture" and
                not self.group_input_closed
            )

            if self.enable_group_mask:
                preprocess_ready = group_input_ready
                pulse_pair_valid = group_output_valid
                x_to_buffer = group_x_output
                d_to_buffer = group_d_output
                preprocessing_frame_done = self.group_frame_done
            else:
                preprocess_ready = (
                    fifo_ready or
                    (preprocess_valid and not keep_pair)
                )
                pulse_pair_valid = preprocess_valid and keep_pair
                x_to_buffer = x_preprocessed
                d_to_buffer = d_preprocessed
                preprocessing_frame_done = (
                    preprocess_valid and
                    preprocess_ready and
                    preprocess_last
                )

            source_path_ready = (
                sort_input_ready if self.enable_sort else preprocess_ready
            )
            source_fire = source_input_valid and source_path_ready

            sort_input_fire = (
                self.enable_sort and
                source_input_valid and
                sort_input_ready
            )
            sort_output_fire = (
                self.enable_sort and
                preprocess_valid and
                preprocess_ready
            )
            group_input_fire = (
                self.enable_group_mask and
                preprocess_valid and
                group_input_ready
            )
            group_output_fire = (
                self.enable_group_mask and
                group_output_valid and
                fifo_ready
            )
            fifo_push = pulse_pair_valid and fifo_ready

            transform_input_fire = preprocess_valid and preprocess_ready
            if transform_input_fire:
                self.accumulate_crossbar_update(
                    self.transform_input_updates,
                    x_preprocessed,
                    d_preprocessed,
                )
            if fifo_push:
                self.accumulate_crossbar_update(
                    self.transform_output_updates,
                    x_to_buffer,
                    d_to_buffer,
                )
            if preprocessing_frame_done:
                if self.transform_input_updates != self.transform_output_updates:
                    raise AssertionError(
                        "{} preprocessing changed frame {} crossbar updates".format(
                            self.architecture,
                            self.validated_transform_frames,
                        )
                    )
                self.validated_transform_frames += 1
                self.transform_input_updates = [0] * (
                    DIMENSION * DIMENSION
                )
                self.transform_output_updates = [0] * (
                    DIMENSION * DIMENSION
                )

            frame_done_event = self.frame_done
            if fifo_valid:
                self.events.append((
                    0,
                    self.completed_frames,
                    pack_pulses(fifo_head[0]),
                    pack_pulses(fifo_head[1]),
                ))
            if frame_done_event:
                if fifo_valid:
                    raise AssertionError(
                        "{} emitted FRAME_DONE with a valid output".format(
                            self.architecture
                        )
                    )
                self.events.append((
                    1, self.completed_frames, 0, 0
                ))
                self.completed_frames += 1

            old_lfsr = self.lfsr_value
            old_d_delay_1 = self.d_lfsr_delay_1
            self.lfsr_value = next_lfsr(old_lfsr)
            self.d_lfsr_delay_1 = old_lfsr
            self.d_lfsr_delay_2 = old_d_delay_1

            if self.enable_sort:
                if sort_input_fire:
                    self.sort_x_frame[
                        self.sort_input_index
                    ] = x_pulses_generated
                    self.sort_d_counts = [
                        count + pulse
                        for count, pulse in zip(
                            self.sort_d_counts,
                            d_pulses_generated,
                        )
                    ]
                    if source_last:
                        self.sort_input_index = 0
                        self.sort_frame_captured = True
                    else:
                        self.sort_input_index += 1

                if sort_output_fire:
                    if preprocess_last:
                        self.sort_output_index = 0
                        self.sort_frame_captured = False
                        self.sort_d_counts = [0] * DIMENSION
                    else:
                        self.sort_output_index += 1

            self.group_frame_done = False
            if self.enable_group_mask:
                if self.group_state == "capture":
                    # Commit the lookup captured on the preceding cycle.
                    pending = self.group_pending
                    self.group_pending = None

                    if pending is not None:
                        (
                            pending_x,
                            pending_d,
                            pending_keep,
                            pending_last,
                        ) = pending

                        if pending_keep:
                            matching_group = None
                            for group in self.groups:
                                if group["d"] == pending_d:
                                    matching_group = group
                                    break

                            if matching_group is None:
                                self.groups.append({
                                    "d": pending_d,
                                    "counts": list(pending_x),
                                })
                            else:
                                matching_group["counts"] = [
                                    count + pulse
                                    for count, pulse in zip(
                                        matching_group["counts"],
                                        pending_x,
                                    )
                                ]

                        if pending_last:
                            self.group_input_closed = False
                            if self.groups:
                                self.group_state = "drain"
                                self.group_drain_index = 0
                                self.group_layer_index = 0
                            else:
                                self.groups = []
                                self.group_frame_done = True

                    # Capture remains one pair per cycle until INPUT_LAST.
                    if group_input_fire:
                        self.group_pending = (
                            x_preprocessed,
                            d_preprocessed,
                            keep_pair,
                            preprocess_last,
                        )
                        if preprocess_last:
                            self.group_input_closed = True

                elif group_output_fire:
                    if another_group_layer:
                        self.group_layer_index += 1
                    elif self.group_drain_index < (len(self.groups) - 1):
                        self.group_drain_index += 1
                        self.group_layer_index = 0
                    else:
                        self.group_state = "capture"
                        self.groups = []
                        self.group_drain_index = 0
                        self.group_layer_index = 0
                        self.group_pending = None
                        self.group_input_closed = False
                        self.group_frame_done = True

            if fifo_pop:
                self.fifo.popleft()
            if fifo_push:
                self.fifo.append((x_to_buffer, d_to_buffer))
            if len(self.fifo) > OUTPUT_BUFFER_DEPTH:
                raise AssertionError("Golden FIFO overflow")

            if source_fire:
                if source_last:
                    self.source_index = 0
                    self.source_set_captured = True
                else:
                    self.source_index += 1

            old_preprocessing_complete = self.preprocessing_complete
            self.frame_done = False
            if preprocessing_frame_done:
                self.preprocessing_complete = True
            if old_preprocessing_complete and not fifo_valid:
                self.source_set_captured = False
                self.preprocessing_complete = False
                self.frame_done = True

            if not driver_started:
                driver_started = True
                driver_valid = True
            elif source_fire:
                self.accepted_samples += 1
                driver_index += 1
                if driver_index % BIT_LENGTH == 0:
                    driver_valid = False
                    driver_waiting_for_frame = True
                else:
                    driver_valid = driver_index < SAMPLE_COUNT
            elif driver_waiting_for_frame and frame_done_event:
                driver_waiting_for_frame = False
                driver_valid = driver_index < SAMPLE_COUNT

            self.cycle += 1

        if self.accepted_samples != SAMPLE_COUNT:
            raise AssertionError(
                "{} accepted {} of {} samples".format(
                    self.architecture,
                    self.accepted_samples,
                    SAMPLE_COUNT,
                )
            )
        if self.fifo:
            raise AssertionError(
                "{} completed with {} buffered outputs".format(
                    self.architecture, len(self.fifo)
                )
            )
        expected_frames = SAMPLE_COUNT // BIT_LENGTH
        if self.validated_transform_frames != expected_frames:
            raise AssertionError(
                "{} validated {} of {} preprocessing frames".format(
                    self.architecture,
                    self.validated_transform_frames,
                    expected_frames,
                )
            )
        return self.events


def event_lines(events):
    pulse_digits = max(1, (DIMENSION + 3) // 4)
    return [
        "{} {} {:0{}x} {:0{}x}".format(
            event_type,
            frame_index,
            x_pulses,
            pulse_digits,
            d_pulses,
            pulse_digits,
        )
        for event_type, frame_index, x_pulses, d_pulses in events
    ]


def write_or_check(path, lines, check_only):
    content = "\n".join(lines) + "\n"
    if check_only:
        if not path.is_file():
            raise ValueError("Missing generated file: {}".format(path))
        existing = path.read_text(encoding="ascii")
        if existing != content:
            raise ValueError("Generated file is stale: {}".format(path))
    else:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content, encoding="ascii")


def validate_events(architecture, events):
    expected_frame = 0
    output_count = 0
    for event_type, frame_index, _x_value, _d_value in events:
        if frame_index != expected_frame:
            raise AssertionError(
                "{} event frame {} expected {}".format(
                    architecture, frame_index, expected_frame
                )
            )
        if event_type == 0:
            output_count += 1
        elif event_type == 1:
            expected_frame += 1
        else:
            raise AssertionError("Invalid event type")

    if expected_frame != (SAMPLE_COUNT // BIT_LENGTH):
        raise AssertionError(
            "{} generated {} completed frames".format(
                architecture, expected_frame
            )
        )
    return output_count


def frame_update_signatures(events):
    """Return each frame's accumulated X-by-D crossbar update matrix."""
    signatures = []
    update_counts = [0] * (DIMENSION * DIMENSION)
    for event_type, _frame_index, x_value, d_value in events:
        if event_type == 0:
            for x_lane in range(DIMENSION):
                if not ((x_value >> x_lane) & 1):
                    continue
                for d_lane in range(DIMENSION):
                    if (d_value >> d_lane) & 1:
                        update_counts[x_lane * DIMENSION + d_lane] += 1
        else:
            signatures.append(tuple(update_counts))
            update_counts = [0] * (DIMENSION * DIMENSION)
    return tuple(signatures)


def validate_equivalent_updates(events_by_architecture):
    """Cross-check equivalent families driven by fixed external random values."""
    equivalent_families = (
        (
            "baseline", "zero_delete", "group_mask",
            "zero_delete_group_mask",
        ),
        (
            "sort", "sort_zero_delete", "sort_group_mask",
            "sort_zero_delete_group_mask",
        ),
    )
    for family in equivalent_families:
        reference = frame_update_signatures(events_by_architecture[family[0]])
        for architecture in family[1:]:
            if frame_update_signatures(events_by_architecture[architecture]) != reference:
                raise AssertionError(
                    "{} does not preserve {} crossbar updates".format(
                        architecture, family[0]
                    )
                )


def main():
    args = parse_args()
    stimuli = read_vector_pairs(args.stimulus)
    random_pairs = generate_random_pairs()

    write_or_check(
        args.random_output,
        packed_pair_lines(random_pairs),
        args.check,
    )

    manifest_rows = []
    events_by_architecture = {}
    for architecture, flags in ARCHITECTURES.items():
        model = GoldenArchitecture(architecture, flags)
        events = model.run(stimuli, random_pairs)
        events_by_architecture[architecture] = events
        output_count = validate_events(architecture, events)
        expected_path = args.expected_dir / (
            architecture + ".expected"
        )
        write_or_check(
            expected_path,
            event_lines(events),
            args.check,
        )
        manifest_rows.append({
            "architecture": architecture,
            "expected_events": len(events),
            "expected_outputs": output_count,
            "expected_frames": SAMPLE_COUNT // BIT_LENGTH,
            "model_cycles": model.cycle,
        })
        print(
            "{:<38} outputs={:<5} events={:<5} cycles={}".format(
                architecture,
                output_count,
                len(events),
                model.cycle,
            )
        )

    validate_equivalent_updates(events_by_architecture)

    manifest_path = args.expected_dir / "manifest.csv"
    manifest_lines = [
        "architecture,expected_events,expected_outputs,expected_frames,model_cycles"
    ]
    manifest_lines.extend(
        "{architecture},{expected_events},{expected_outputs},"
        "{expected_frames},{model_cycles}".format(**row)
        for row in manifest_rows
    )
    write_or_check(manifest_path, manifest_lines, args.check)

    action = "Checked" if args.check else "Generated"
    print(
        "{} {} architecture expected files in {}".format(
            action, len(ARCHITECTURES), args.expected_dir
        )
    )
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (AssertionError, OSError, ValueError) as error:
        print("ERROR: {}".format(error), file=sys.stderr)
        sys.exit(1)

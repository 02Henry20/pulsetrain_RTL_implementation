#!/bin/tcsh -f

if ($#argv != 1) then
    echo "Usage: $0 <architecture>"
    exit 1
endif

set SCRIPT_DIR = `dirname "$0"`
set SYNTH_DIR = `cd "${SCRIPT_DIR}" && pwd`
set PROJECT_ROOT = `cd "${SYNTH_DIR}/.." && pwd`
set SELECTED_ARCH = "$argv[1]"
set FILELIST = "${PROJECT_ROOT}/SIM/FUNCTION/filelists/${SELECTED_ARCH}.f"
set RUN_DIR = "${SYNTH_DIR}/runs/${SELECTED_ARCH}/no_saif"
set LOG_DIR = "${RUN_DIR}/logs"
set REPORTS_DIR = "${RUN_DIR}/reports"
set RESULTS_DIR = "${RUN_DIR}/results"
set LOG_FILE = "${LOG_DIR}/all.log"
set MW_LIB_NAME = "MY_DESIGN_LIB_${SELECTED_ARCH}_no_saif"
set PRECOMPILE_HIERARCHY_REPORT = "${REPORTS_DIR}/precompile_hierarchy.rpt"

if (! $?SYNTH_TARGET_PERIOD_NS) then
    setenv SYNTH_TARGET_PERIOD_NS "3"
endif
echo "${SYNTH_TARGET_PERIOD_NS}" | awk '$0 ~ /^[0-9]+([.][0-9]+)?$/ && ($0 + 0) > 0 { valid=1 } END { exit !valid }'
if ($status != 0) then
    echo "ERROR: SYNTH_TARGET_PERIOD_NS must be a positive number"
    exit 1
endif
# Synthesis always elaborates the complete hardware path, including RNG logic.
setenv RAW_REPLAY_MODE "0"

if (! -e "${FILELIST}") then
    echo "ERROR: architecture file list not found: ${FILELIST}"
    exit 1
endif
if (! -e "${SYNTH_DIR}/script/dc.tcl") then
    echo "ERROR: Design Compiler script not found"
    exit 1
endif

cd "${SYNTH_DIR}"
rm -rf "${RUN_DIR}"
mkdir -p "${LOG_DIR}" "${REPORTS_DIR}" "${RESULTS_DIR}"
rm -rf WORK "${MW_LIB_NAME}"

setenv SYNTH_ARCH "${SELECTED_ARCH}"
setenv SYNTH_RUN_LABEL "no_saif"
unsetenv SAIF_FILE
unsetenv SAIF_INSTANCE

dc_shell -topo -f script/dc.tcl >&! "${LOG_FILE}"
set DC_STATUS = $status

if (${DC_STATUS} != 0) then
    echo "ERROR: synthesis failed; see ${LOG_FILE}"
    exit ${DC_STATUS}
endif
grep -qE "^(Error:|RM-Error:)" "${LOG_FILE}"
if ($status == 0) then
    echo "ERROR: synthesis completed with reported errors; see ${LOG_FILE}"
    exit 1
endif
if (! -e "${PRECOMPILE_HIERARCHY_REPORT}") then
    echo "ERROR: missing precompile hierarchy report: ${PRECOMPILE_HIERARCHY_REPORT}"
    exit 1
endif
grep -qi "lfsr" "${PRECOMPILE_HIERARCHY_REPORT}"
if ($status != 0) then
    echo "ERROR: synthesized configuration lacks LFSR hierarchy"
    exit 1
endif
grep -qi "pulse_generator" "${PRECOMPILE_HIERARCHY_REPORT}"
if ($status != 0) then
    echo "ERROR: synthesized configuration lacks pulse-generator hierarchy"
    exit 1
endif

echo "PASS: synthesis ${SELECTED_ARCH}"
exit 0
